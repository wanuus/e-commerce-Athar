# ---------- Required ----------
# Local Postgres (Homebrew) example: postgresql://YOUR_MAC_USERNAME@localhost:5432/athar
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/athar"

# Generate with:  openssl rand -base64 32
AUTH_SECRET=""

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Seeding (only used by `npm run db:seed`) ----------
# Admin account created by the seed. Choose your own; nothing is created if empty.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Set to "true" in development ONLY to add demo T-shirts. Never in production.
SEED_DEMO="false"

# ---------- Payments (Paymob) ----------
# Leave empty in development: a clearly-labelled TEST card page is used instead (never in production).
# Dashboard -> Settings -> Account Info (keys) and Payment Integrations (integration id).
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_HMAC_SECRET=""

# ---------- Email (Resend) ----------
# Leave empty in development: emails are printed in the terminal instead.
RESEND_API_KEY=""
EMAIL_FROM="ATHAR <orders@yourdomain.com>"

# ---------- Scheduled jobs ----------
# Random string; protects /api/cron/expire-orders
CRON_SECRET=""

# ---------- Images (Cloudinary) ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- Optional: analytics + error monitoring ----------
# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Loads only after a visitor accepts cookies.
NEXT_PUBLIC_GA_ID=""
# Sentry project DSN (server errors are reported when set)
SENTRY_DSN=""
